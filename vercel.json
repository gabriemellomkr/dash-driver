{
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.dashdriver.com.br" }],
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/corridas.html" }
  ],
  "crons": [
    { "path": "/api/cron-resumo", "schedule": "0 0 * * *" }
  ],
  "functions": {
    "api/ocr-corrida.js":        { "maxDuration": 30 },
    "api/admin/users.js":        { "maxDuration": 30 },
    "api/admin/stats.js":        { "maxDuration": 15 },
    "api/admin/broadcast.js":    { "maxDuration": 60 },
    "api/stripe/webhook.js":     { "maxDuration": 15 }
  }
}
