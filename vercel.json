{
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/cron-resumo",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/ocr-corrida.js": {
      "maxDuration": 30
    },
    "api/admin/users.js": {
      "maxDuration": 30
    },
    "api/admin/stats.js": {
      "maxDuration": 15
    },
    "api/admin/broadcast.js": {
      "maxDuration": 60
    },
    "api/cron-resumo.js": {
      "maxDuration": 60
    },
    "api/lastlink-webhook.js": {
      "maxDuration": 30
    },
    "api/privacy.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/admin(?:\\.html)?",
      "has": [
        {
          "type": "host",
          "value": "admin.dashdriver.com.br"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.dashdriver.com.br"
        }
      ],
      "dest": "/admin.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/api/whatsapp",
      "dest": "/api/notify?retired=whatsapp"
    },
    {
      "handle": "filesystem"
    }
  ]
}
